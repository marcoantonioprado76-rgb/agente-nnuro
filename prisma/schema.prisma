  accountId    String    @map("account_id")
  accountName  String    @map("account_name")
  accountAvatar String?  @map("account_avatar")
  pageId       String?   @map("page_id")
  pageName     String?   @map("page_name")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts SocialPostNetwork[]

  @@unique([userId, network])
  @@map("social_connections")
}

// Perfil de CONTENIDO de una página (equivalente del brief, pero para contenido orgánico,
// NO publicidad). Uno por página/negocio. Alimenta la generación de imágenes y texto del
// Publicador Social para que el contenido sea real y on-brand.
model SocialContentProfile {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  pageName      String   @map("page_name")                // nombre de la página/negocio
  about         String   @default("") @db.Text            // de qué trata la página
  audience      String   @default("") @db.Text            // a quién le habla
  tone          String[] @default([])                     // tono / personalidad
  contentThemes String[] @default([]) @map("content_themes") // pilares / temas de contenido
  brandColors   String[] @default([]) @map("brand_colors")
  visualStyle   String[] @default([]) @map("visual_style")
  contentGoal   String   @default("") @map("content_goal")  // objetivo del contenido
  language      String   @default("es")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("social_content_profiles")
}

model SocialPost {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  content     String
  mediaUrl    String?   @map("media_url")
  mediaType   String?   @map("media_type")
  postType    String    @default("feed") @map("post_type")
  status      String    @default("DRAFT")
  scheduledAt DateTime? @map("scheduled_at")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  networks SocialPostNetwork[]

  @@map("social_posts")
}

model SocialPostNetwork {
  id             String    @id @default(uuid()) @db.Uuid
  postId         String    @map("post_id") @db.Uuid
  connectionId   String    @map("connection_id") @db.Uuid
  network        String
  status         String    @default("PENDING")
  providerPostId String?   @map("provider_post_id")
  error          String?
  publishedAt    DateTime? @map("published_at")

  post       SocialPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  connection SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)


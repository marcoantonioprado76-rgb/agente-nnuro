// ─── Ticket / Entradas ──────────────────────────────────────────────────────

model Event {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  description String
  image       String?
  date        DateTime?
  location    String?
  active      Boolean      @default(true)
  /// QR bancario (imagen) para que el comprador pague por transferencia/QR.
  paymentQrUrl String?     @map("payment_qr_url")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  ticketTypes TicketType[]
  tickets     TicketOrder[]

  @@map("events")
}

model TicketType {
  id               String   @id @default(uuid()) @db.Uuid
  eventId          String   @map("event_id") @db.Uuid
  name             String
  description      String?
  image            String?
  price            Decimal  @db.Decimal(10, 2)
  /// INVITADO: entrada GRATIS. No se paga: solo se registra y se emite el QR.
  /// Estos se listan aparte (sección "Invitados"), separados de las ventas.
  isGuest          Boolean  @default(false) @map("is_guest")
  capacity         Int?
  bulkMinQty       Int?     @map("bulk_min_qty")
  bulkDiscountPct  Decimal? @db.Decimal(5, 2) @map("bulk_discount_pct")
  active           Boolean  @default(true)
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")

  event   Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets TicketOrder[]

  @@map("ticket_types")
}

enum TicketStatus {
  PENDING
  APPROVED
  REJECTED
}

model TicketOrder {
  id               String       @id @default(uuid()) @db.Uuid
  eventId          String       @map("event_id") @db.Uuid
  ticketTypeId     String       @map("ticket_type_id") @db.Uuid
  ticketTypeName   String       @map("ticket_type_name")
  customerName     String       @map("customer_name")
  customerEmail    String       @map("customer_email")
  customerPhone    String       @map("customer_phone")
  ticketCode       String       @unique @map("ticket_code")
  quantity         Int          @default(1)
  unitPrice        Decimal      @map("unit_price") @db.Decimal(10, 2)
  totalPrice       Decimal      @map("total_price") @db.Decimal(10, 2)
  paymentMethod    String       @default("MANUAL") @map("payment_method")
  proofUrl         String?      @map("proof_url")
  txHash           String?      @unique @map("tx_hash")
  blockNumber      BigInt?      @map("block_number")
  status           TicketStatus @default(PENDING)
  notes            String?
  purchaseGroupId  String?      @db.Uuid @map("purchase_group_id")
  checkedIn        Boolean      @default(false) @map("checked_in")
  checkedInAt      DateTime?    @map("checked_in_at")
  /// Tipo de cambio de BINANCE usado al momento de la compra (1 USDT = X Bs) y el
  /// total en bolivianos. Queda CONGELADO: aunque el cambio suba o baje después, el
  /// precio de esa compra siempre se lee con esta referencia.
  bsRate           Decimal?     @map("bs_rate") @db.Decimal(10, 2)
  totalBs          Decimal?     @map("total_bs") @db.Decimal(10, 2)
  /// La entrada (con QR) ya se envió por WhatsApp.
  waSentAt         DateTime?    @map("wa_sent_at")
  /// Recordatorios ya enviados (evita repetirlos en cada tick del worker).
  reminder1dAt     DateTime?    @map("reminder_1d_at")
  reminder2hAt     DateTime?    @map("reminder_2h_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  @@index([ticketCode])
  @@index([status])
  @@index([eventId, status])
  @@index([ticketTypeId, status])
  @@index([purchaseGroupId])
  @@map("ticket_orders")
}

// ─── Social Media Publisher ─────────────────────────────────────────────────

model SocialConnection {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  network      String    // FACEBOOK | INSTAGRAM | TIKTOK | YOUTUBE

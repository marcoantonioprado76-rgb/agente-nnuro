// ─── CRM Broadcast ────────────────────────────────────────────────────────────

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  PAUSED
  FAILED
}

enum BroadcastLogStatus {
  PENDING
  SENT
  FAILED
}

model BroadcastCampaign {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  botId          String          @map("bot_id") @db.Uuid
  name           String
  prompt         String          @db.Text
  messageExample String?         @db.Text @map("message_example")
  status         BroadcastStatus @default(DRAFT)
  delayValue     Int             @default(30) @map("delay_value")
  delayUnit      String          @default("seconds") @map("delay_unit")
  scheduledAt    DateTime?       @map("scheduled_at")
  startedAt      DateTime?       @map("started_at")
  completedAt    DateTime?       @map("completed_at")
  imageIndex     Int             @default(0) @map("image_index")
  totalContacts  Int             @default(0) @map("total_contacts")
  sentCount      Int             @default(0) @map("sent_count")
  failedCount    Int             @default(0) @map("failed_count")
  // Fase 3 — remarketing recurrente
  recurring         Boolean   @default(false)
  recurrenceDays    String?   @map("recurrence_days")        // CSV de días 0-6 (0=domingo), hora Bolivia
  recurrenceTime    String?   @map("recurrence_time")        // "HH:mm" hora Bolivia
  recurrenceImageId String?   @map("recurrence_image_id") @db.Uuid
  nextRunAt         DateTime? @map("next_run_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bot      Bot                @relation(fields: [botId], references: [id], onDelete: Cascade)
  images   BroadcastImage[]
  contacts BroadcastContact[]
  logs     BroadcastLog[]

  @@index([userId, status])
  @@map("broadcast_campaigns")
}

model BroadcastImage {
  id         String   @id @default(uuid()) @db.Uuid
  campaignId String   @map("campaign_id") @db.Uuid
  url        String
  type       String   @default("IMAGE")
  order      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  campaign BroadcastCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("broadcast_images")
}

model BroadcastContact {
  id         String             @id @default(uuid()) @db.Uuid
  campaignId String             @map("campaign_id") @db.Uuid
  name       String?
  phone      String
  status     BroadcastLogStatus @default(PENDING)
  sentAt     DateTime?          @map("sent_at")
  error      String?
  // Fase 4 — opt-out (BAJA)
  optedOut   Boolean            @default(false) @map("opted_out")
  optedOutAt DateTime?          @map("opted_out_at")
  createdAt  DateTime           @default(now()) @map("created_at")

  campaign BroadcastCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@map("broadcast_contacts")
}

model BroadcastLog {
  id         String             @id @default(uuid()) @db.Uuid
  campaignId String             @map("campaign_id") @db.Uuid
  phone      String
  name       String?
  message    String             @db.Text
  imageUrl   String?            @map("image_url")
  status     BroadcastLogStatus @default(SENT)
  error      String?
  sentAt     DateTime           @default(now()) @map("sent_at")

  campaign BroadcastCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("broadcast_logs")
}

// ─── Recursos: plantillas editables (editor tipo Fancy Product Designer) ──────────
// Sección AISLADA. No tiene relaciones con otros modelos para no afectar nada.
// `creadoPor` guarda el userId del admin que la creó (sin FK, a propósito).
model Template {
  id        String   @id @default(uuid()) @db.Uuid
  organizationId String? @map("organization_id") @db.Uuid
  nombre    String
  categoria String
  ancho     Int
  alto      Int
  fondoUrl  String   @map("fondo_url")
  thumbUrl  String?  @map("thumb_url")
  zonas     Json     @db.JsonB
  activo    Boolean  @default(true)
  creadoPor String   @map("creado_por") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@index([activo, categoria])
  @@map("templates")
}

// ─── Recursos: presentaciones y libros (PDF: ver / descargar / flipbook) ──────────
// Sección AISLADA, sin relaciones. tipo = 'presentacion' | 'libro'.
model Resource {
  id         String   @id @default(uuid()) @db.Uuid
  organizationId String? @map("organization_id") @db.Uuid
  tipo       String
  titulo     String
  categoria  String
  archivoUrl String   @map("archivo_url")
  portadaUrl String?  @map("portada_url")
  paginas    Int?
  activo     Boolean  @default(true)
  creadoPor  String   @map("creado_por") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tipo, activo, categoria])
  @@map("resources")
}

// Áreas (categorías) de los flyers — el admin elige cuáles aparecen en el menú "Filtrar flyers".
model FlyerArea {
  id        String   @id @default(uuid()) @db.Uuid
  nombre    String   @unique
  orden     Int      @default(0)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([activo, orden])
  @@map("flyer_areas")
}

// ── Pack Empresarial (multi-empresa / white-label) ──
enum OrgRole {
  NONE
  ORG_ADMIN
  ORG_USER
}

/// Una empresa Pack Empresarial. Tiene su admin, su cupo de usuarios y su contenido.
model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  maxUsers    Int      @default(0) @map("max_users")
  active      Boolean  @default(true)
  billingNote String?  @map("billing_note")
  logoUrl     String?  @map("logo_url")
  // Cobro propio de la empresa (transferencia / USDT) — lo configura su admin.
  payUsdtWallet   String? @map("pay_usdt_wallet")
  payUsdtNetwork  String? @map("pay_usdt_network")
  payBankInfo     String? @map("pay_bank_info")     @db.Text
  payQrUrl        String? @map("pay_qr_url")
  payInstructions String? @map("pay_instructions")  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  members     User[]   @relation("OrgMembers")

  @@map("organizations")
}

// ═══════════════════════════════════════════════════════════════════════════
// Reto 90D WhatsApp — módulo de retos de 90 días vía WhatsApp (Baileys).
// ADITIVO: no modifica ningún modelo existente. `userId` es columna suelta
// (sin relación Prisma) para NO tocar el modelo User. Tablas: reto90d_*.
// ═══════════════════════════════════════════════════════════════════════════

model Challenge {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  description      String?  @db.Text
  startDate        DateTime @map("start_date")
  endDate          DateTime @map("end_date")
  isActive         Boolean  @default(true) @map("is_active")
  publicSlug       String?  @unique @map("public_slug")        // código del link público de registro
  registrationOpen Boolean  @default(false) @map("registration_open") // el link acepta registros
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tasks   DailyTask[]
  members ChallengeMember[]
  reports DailyReport[]

  @@map("reto90d_challenges")
}

model DailyTask {
  id               String   @id @default(uuid()) @db.Uuid
  challengeId      String   @map("challenge_id") @db.Uuid
  title            String
  description      String   @db.Text
  evidenceType     String   @map("evidence_type")      // IMAGE | TEXT | NUMBER | LINK | DOCUMENT
  expectedKeywords String[] @map("expected_keywords")
  points           Int      @default(10)
  deadlineTime     String   @map("deadline_time")      // "HH:mm"
  autoApproveMin   Float    @default(0.85) @map("auto_approve_min")
  requiresReview   Boolean  @default(false) @map("requires_review")
  validExamples    String[] @map("valid_examples")     // URLs de evidencia válida (ejemplos)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  challenge   Challenge        @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  submissions TaskSubmission[]

  @@index([challengeId])
  @@map("reto90d_tasks")
}

model ChallengeMember {
  id          String   @id @default(uuid()) @db.Uuid
  challengeId String   @map("challenge_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid       // enlaza con User (columna suelta, sin relación)
  fullName    String   @map("full_name")
  phone       String
  email       String?
  country     String?
  city        String?
  status      String   @default("ACTIVE")             // ACTIVE | PAUSED | REMOVED
  joinedAt    DateTime @default(now()) @map("joined_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, phone])
  @@index([phone])
  @@map("reto90d_members")
}

model TaskSubmission {
  id             String    @id @default(uuid()) @db.Uuid
  taskId         String?   @map("task_id") @db.Uuid
  challengeId    String?   @map("challenge_id") @db.Uuid
  userId         String?   @map("user_id") @db.Uuid
  fullName       String?   @map("full_name")
  phone          String
  whatsappMsgId  String    @unique @map("whatsapp_msg_id")   // anti-dup nivel 1
  mediaUrl       String?   @map("media_url")
  mediaHash      String?   @map("media_hash")                // anti-dup nivel 2
  textContent    String?   @map("text_content") @db.Text
  aiTaskDetected String?   @map("ai_task_detected")
  aiConfidence   Float?    @map("ai_confidence")
  aiExplanation  String?   @map("ai_explanation") @db.Text
  status         String    @default("PENDING")   // PENDING|APPROVED|REJECTED|REVIEW|DUPLICATED|NEEDS_CLARIFICATION
  pointsEarned   Int       @default(0) @map("points_earned")
  reviewedBy     String?   @map("reviewed_by")
  reviewedAt     DateTime? @map("reviewed_at")
  submittedAt    DateTime  @default(now()) @map("submitted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  task       DailyTask?            @relation(fields: [taskId], references: [id], onDelete: SetNull)
  reviewLogs SubmissionReviewLog[]

  @@index([phone])
  @@index([challengeId])
  @@index([status])
  @@index([mediaHash])
  @@index([challengeId, phone, submittedAt])
  @@map("reto90d_submissions")
}

model DailyReport {
  id          String   @id @default(uuid()) @db.Uuid
  challengeId String   @map("challenge_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  fullName    String?  @map("full_name")
  phone       String
  reportDate  DateTime @map("report_date")
  totalTasks  Int      @map("total_tasks")
  completed   Int
  pending     Int
  rejected    Int
  review      Int
  points      Int
  summary     String   @db.Text
  sentToUser  Boolean  @default(false) @map("sent_to_user")
  sentToAdmin Boolean  @default(false) @map("sent_to_admin")
  sentToGroup Boolean  @default(false) @map("sent_to_group")
  createdAt   DateTime @default(now()) @map("created_at")

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, phone, reportDate])
  @@index([reportDate])
  @@map("reto90d_reports")
}

model SubmissionReviewLog {
  id             String   @id @default(uuid()) @db.Uuid
  submissionId   String   @map("submission_id") @db.Uuid
  reviewedBy     String   @map("reviewed_by")
  previousStatus String   @map("previous_status")
  newStatus      String   @map("new_status")
  reason         String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  submission TaskSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("reto90d_review_logs")
}

model WhatsAppConfig {
  id                    String   @id @default(uuid()) @db.Uuid
  challengeId           String?  @map("challenge_id") @db.Uuid
  botId                 String?  @map("bot_id") @db.Uuid   // bot Baileys dedicado del reto
  adminPhone            String?  @map("admin_phone")
  groupId               String?  @map("group_id")          // JID del grupo (...@g.us)
  isActive              Boolean  @default(true) @map("is_active")
  sendGroupReports      Boolean  @default(false) @map("send_group_reports")
  morningReminderTime   String   @default("09:00") @map("morning_reminder_time")
  middayReminderTime    String   @default("12:30") @map("midday_reminder_time")
  afternoonReminderTime String   @default("17:30") @map("afternoon_reminder_time")
  nightReminderTime     String   @default("21:30") @map("night_reminder_time")
  finalReportTime       String   @default("23:50") @map("final_report_time")
  timezone              String   @default("America/La_Paz")
  botInstructions       String?  @db.Text @map("bot_instructions")   // system prompt: tono, trato y contexto del plan
  welcomeMessage        String?  @db.Text @map("welcome_message")    // bienvenida al registrarse ({nombre}, {reto})
  openaiApiKeyEnc       String?  @db.Text @map("openai_api_key_enc") // API key de OpenAI del reto (cifrada)
  elevenLabsApiKeyEnc   String?  @db.Text @map("elevenlabs_api_key_enc") // API key de ElevenLabs (cifrada)
  voiceId               String?  @map("voice_id")                    // voz elegida para las notas de voz
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("reto90d_whatsapp_config")
}

// Memoria de conversación del bot con cada participante (para recordar el hilo
// y responder "¿qué tarea me falta?" con contexto).
model RetoMessage {
  id          String   @id @default(uuid()) @db.Uuid
  challengeId String   @map("challenge_id") @db.Uuid
  phone       String
  role        String   // 'user' | 'bot'
  content     String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([challengeId, phone, createdAt])
  @@map("reto90d_messages")
}

// Idempotencia PERSISTENTE de envíos programados (recordatorios y resúmenes).
// Antes de enviar cada tipo por día, el scheduler intenta INSERTAR la fila única
// (challengeId, kind, date); si ya existe, no reenvía. Si el envío falla por
// completo (bot caído), la fila se borra para reintentar en el próximo tick.
model RetoSendLog {
  id          String   @id @default(uuid()) @db.Uuid
  challengeId String   @map("challenge_id") @db.Uuid
  kind        String   // morning | midday | afternoon | night | resumen_semana | resumen_mes
  date        String   // 'YYYY-MM-DD' en la zona del reto (America/La_Paz)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([challengeId, kind, date])
  @@map("reto90d_send_log")
}

// ════════════════════════════════════════════════════════════════════════════
//  DIAMOND ASSISTANT — FASE 0 (fundación)
//  Centro de comunicación WhatsApp con agentes IA para equipos.
//
//  Sección AISLADA (igual que el modelo `Template`): los modelos diamond_*
//  NO tienen FK hacia User / Bot / Organization. Las referencias externas
//  (botId, createdBy=userId, organizationId) son columnas UUID PLANAS sin
//  @relation, para no tener que tocar esos modelos ni afectar nada existente.
//  Las relaciones INTERNAS entre modelos diamond_* sí llevan FK (cascade).
//  Multi-equipo: casi todo lleva organizationId (nullable).
// ════════════════════════════════════════════════════════════════════════════

enum DiamondProvider {
  BAILEYS
  YCLOUD
  META
}

enum DiamondMediaType {
  IMAGE
  VIDEO
  AUDIO
  PDF
  LINK
  TEXT
}

enum DiamondCampaignStatus {
  DRAFT
  PENDING_APPROVAL
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum DiamondMsgStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  ERROR
}

enum DiamondContactStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum DiamondRuleType {
  FORBID
  ESCALATE
  REQUIRE_APPROVAL
}

/// El agente IA: personalidad, modelo, proveedor y config del asistente.
/// botId y createdBy son UUID planos (sin FK, a propósito).
model AssistantAgent {
  id                String          @id @default(uuid()) @db.Uuid
  organizationId    String?         @map("organization_id") @db.Uuid
  createdBy         String?         @map("created_by") @db.Uuid
  name              String
  avatarUrl         String?         @map("avatar_url")
  personalityPrompt String          @map("personality_prompt") @db.Text
  model             String          @default("gpt-4o")
  temperature       Float           @default(0.4)
  provider          DiamondProvider @default(BAILEYS)
  botId             String?         @map("bot_id") @db.Uuid
  openaiKeyEnc      String?         @map("openai_key_enc") @db.Text
  providerApiKeyEnc String?         @map("provider_api_key_enc") @db.Text
  providerSender    String?         @map("provider_sender")
  webhookToken      String?         @map("webhook_token")
  timezone          String          @default("America/La_Paz")
  allowedHours      Json?           @map("allowed_hours")
  // Voz: responder con nota de voz (ElevenLabs). Modo: off | audio_in | always.
  voiceEnabled      Boolean         @default(false) @map("voice_enabled")
  voiceMode         String          @default("off") @map("voice_mode")
  voiceId           String?         @map("voice_id")
  isActive          Boolean         @default(true) @map("is_active")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  // Relaciones internas (1-N) hacia los demás modelos diamond_*.
  groups           AssistantGroup[]
  knowledge        KnowledgeItem[]
  rules            SafetyRule[]
  campaigns        AssistantCampaign[]
  welcomeTemplates WelcomeTemplate[]
  memory           AssistantMemory[]
  scheduledPosts   AssistantScheduledPost[]
  ownerActions     DiamondOwnerAction[]

  @@map("diamond_agents")
}

/// Grupo de WhatsApp gestionado por un agente. Único por (agente, groupJid).
model AssistantGroup {
  id                String   @id @default(uuid()) @db.Uuid
  agentId           String   @map("agent_id") @db.Uuid
  groupJid          String   @map("group_jid")
  name              String?
  automationEnabled Boolean  @default(true) @map("automation_enabled")
  aiEnabled         Boolean  @default(true) @map("ai_enabled")
  welcomeEnabled    Boolean  @default(false) @map("welcome_enabled")
  welcomeTemplateId String?  @map("welcome_template_id") @db.Uuid
  // Bienvenida al PRIVADO (1:1) de quien entra al grupo. Apagada por defecto.
  privateWelcomeEnabled Boolean @default(false) @map("private_welcome_enabled")
  allowedHours      Json?    @map("allowed_hours")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  agent AssistantAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, groupJid])
  @@map("diamond_groups")
}

/// Plantilla de bienvenida. body soporta variables:
/// {{nombre}} {{grupo}} {{ciudad}} {{sponsor}} {{fecha}} {{link_reto}} {{nombre_lider}}
model WelcomeTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  agentId      String   @map("agent_id") @db.Uuid
  name         String
  body         String   @db.Text
  mediaAssetId String?  @map("media_asset_id") @db.Uuid
  // Varias imágenes/recursos adjuntos (además del legacy `mediaAssetId`).
  mediaAssetIds String[] @default([]) @map("media_asset_ids") @db.Uuid
  // Tipo de bienvenida: GROUP (al grupo) o PRIVATE (al privado 1:1).
  kind         String   @default("GROUP")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  agent AssistantAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("diamond_welcome_templates")
}

/// Publicación PROGRAMADA a un grupo: texto + varias imágenes/videos/flyer/pdf,
/// enviada automáticamente en `scheduledAt`. Puede repetirse (NONE/DAILY/WEEKLY).
model AssistantScheduledPost {
  id            String    @id @default(uuid()) @db.Uuid
  agentId       String    @map("agent_id") @db.Uuid
  groupJid      String    @map("group_jid")
  groupName     String?   @map("group_name")
  body          String?   @db.Text
  mediaAssetIds String[]  @default([]) @map("media_asset_ids") @db.Uuid
  scheduledAt   DateTime  @map("scheduled_at")
  repeat        String    @default("NONE") // NONE | INTERVAL | DAILY | WEEKLY | WEEKDAYS
  // Además del grupo, reenviar el mismo contenido al PRIVADO de quienes ya
  // escribieron al agente (contactos tibios). Seguro (no a desconocidos).
  alsoToPrivate Boolean   @default(false) @map("also_to_private")
  // Para repeat=INTERVAL: cada cuántos minutos se repite ("de cada rato").
  intervalMinutes Int?    @map("interval_minutes")
  // Para repeat=WEEKDAYS: días de la semana en que se lanza (0=domingo … 6=sábado).
  weekdays      Int[]     @default([]) @map("weekdays")
  // Fin de la recurrencia (opcional): deja de enviarse después de esta fecha/hora.
  repeatUntil   DateTime? @map("repeat_until")
  status        String    @default("PENDING") // PENDING | SENT | CANCELLED | FAILED
  lastSentAt    DateTime? @map("last_sent_at")
  sentCount     Int       @default(0) @map("sent_count")
  createdBy     String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  agent AssistantAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([agentId, groupJid])
  @@map("diamond_scheduled_posts")
}

/// "Modo Dueño": acción pendiente de APROBACIÓN pedida por el dueño vía WhatsApp.
/// El cerebro admin propone una acción delicada (programar, campaña, borrar), la
/// guarda acá con status=PENDING y un resumen; cuando el dueño responde "aprobado"
/// se ejecuta el `payload` y pasa a DONE. Así la confirmación es determinista.
model DiamondOwnerAction {
  id         String   @id @default(uuid()) @db.Uuid
  agentId    String   @map("agent_id") @db.Uuid
  ownerPhone String   @map("owner_phone")
  actionType String   @map("action_type") // SCHEDULE_POST | SEND_NOW | LAUNCH_CAMPAIGN | DELETE_KNOWLEDGE | DELETE_MEDIA | ...
  payload    Json // datos estructurados para ejecutar SIN depender del modelo
  summary    String   @db.Text // lo que se le mostró al dueño para aprobar
  status     String   @default("PENDING") // PENDING | DONE | CANCELLED | EXPIRED
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  agent AssistantAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, ownerPhone, status])
  @@map("diamond_owner_actions")
}

/// Contacto / prospecto. Único por (organización, teléfono).
model Contact {
  id                String               @id @default(uuid()) @db.Uuid
  organizationId    String?              @map("organization_id") @db.Uuid
  createdBy         String?              @map("created_by") @db.Uuid
  name              String?
  phone             String
  country           String?
  city              String?
  sponsor           String?
  tag               String?
  status            DiamondContactStatus @default(ACTIVE)
  optIn             Boolean              @default(true) @map("opt_in")
  optInAt           DateTime?            @map("opt_in_at")
  joinedAt          DateTime             @default(now()) @map("joined_at")
  lastInteractionAt DateTime?            @map("last_interaction_at")
  notes             String?              @db.Text
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  @@unique([organizationId, phone])
  @@index([organizationId, status])
  @@map("diamond_contacts")
}

/// Recurso multimedia reutilizable (imagen/video/audio/pdf/link/texto).
model MediaAsset {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String?          @map("organization_id") @db.Uuid
  createdBy      String?          @map("created_by") @db.Uuid
  type           DiamondMediaType
  title          String
  caption        String?          @db.Text  // descripción que se MANDA junto con la imagen/video (el title es interno)
  url            String?
  linkUrl        String?          @map("link_url")
  textContent    String?          @map("text_content") @db.Text
  mimeType       String?          @map("mime_type")
  sizeBytes      Int?             @map("size_bytes")
  tags           Json             @default("[]")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@index([organizationId, type])
  @@map("diamond_media")
}

/// Base de conocimiento del agente (FAQ / info que puede usar la IA).
model KnowledgeItem {
  id        String   @id @default(uuid()) @db.Uuid
  agentId   String   @map("agent_id") @db.Uuid
  title     String
  content   String   @db.Text
  category  String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  agent AssistantAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, isActive])
  @@map("diamond_knowledge")
}

/// Regla de seguridad / guardarraíl del agente.
model SafetyRule {
  id          String          @id @default(uuid()) @db.Uuid
  agentId     String          @map("agent_id") @db.Uuid
  description String          @db.Text
  type        DiamondRuleType @default(FORBID)
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  agent AssistantAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("diamond_safety_rules")
}

/// Campaña de envío (grupo / contacto / segmento), con aprobación y throttling.
/// targetType: GROUP | CONTACT | SEGMENT.
model AssistantCampaign {
  id             String                @id @default(uuid()) @db.Uuid
  agentId        String                @map("agent_id") @db.Uuid
  organizationId String?               @map("organization_id") @db.Uuid
  createdBy      String?               @map("created_by") @db.Uuid
  name           String
  messageBody    String                @map("message_body") @db.Text
  mediaAssetId   String?               @map("media_asset_id") @db.Uuid
  targetType     String                @map("target_type")
  targetJson     Json                  @map("target_json")
  status         DiamondCampaignStatus @default(DRAFT)
  templateJson   Json?                 @map("template_json")  // { name, language, params } → enviar por plantilla aprobada (fuera de 24h)
  scheduledAt    DateTime?             @map("scheduled_at")
  recurring      Boolean               @default(false)
  recurrenceJson Json?                 @map("recurrence_json")
  throttleMs     Int                   @default(1000) @map("throttle_ms")
  totalTargets   Int                   @default(0) @map("total_targets")
  sentCount      Int                   @default(0) @map("sent_count")
  failedCount    Int                   @default(0) @map("failed_count")
  approvedBy     String?               @map("approved_by") @db.Uuid
  approvedAt     DateTime?             @map("approved_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  agent AssistantAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, status])
  @@map("diamond_campaigns")
}

/// Log de mensajes IN/OUT. agentId sin FK (para no forzar la relación).
/// direction: IN | OUT.
model AssistantMessageLog {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String?          @map("organization_id") @db.Uuid
  agentId        String?          @map("agent_id") @db.Uuid
  campaignId     String?          @map("campaign_id") @db.Uuid
  contactPhone   String           @map("contact_phone")
  direction      String
  messageType    DiamondMediaType @default(TEXT) @map("message_type")
  content        String?          @db.Text
  mediaAssetId   String?          @map("media_asset_id") @db.Uuid
  status         DiamondMsgStatus @default(PENDING)
  error          String?          @db.Text
  /// ID del mensaje del proveedor (wamid de WhatsApp) — dedup de entrantes.
  providerMsgId  String?          @map("provider_msg_id")
  createdAt      DateTime         @default(now()) @map("created_at")

  @@unique([providerMsgId])
  @@index([organizationId, createdAt])
  @@index([campaignId])
  @@map("diamond_message_logs")
}

/// Memoria de conversación agente ↔ contacto. role: user | bot.
model AssistantMemory {
  id           String   @id @default(uuid()) @db.Uuid
  agentId      String   @map("agent_id") @db.Uuid
  contactPhone String   @map("contact_phone")
  role         String
  content      String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  agent AssistantAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, contactPhone, createdAt])
  @@map("diamond_memory")
}

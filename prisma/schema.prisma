// ─── Admin & Commerce Models ──────────────────────────────────────────────────

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  PENDING_VERIFICATION
}

enum PaymentMethod {
  MANUAL
  CRYPTO
  FASE_GLOBAL
}

model PackPurchaseRequest {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  plan            UserPlan
  price           Decimal       @db.Decimal(10, 2)
  paymentProofUrl String?       @map("payment_proof_url")
  paymentMethod   PaymentMethod @default(MANUAL) @map("payment_method")
  txHash          String?       @unique @map("tx_hash")
  blockNumber     BigInt?       @map("block_number")
  // Pago cripto "monto único" (crypto-B): monto exacto USDT a enviar (4 decimales únicos)
  // + vencimiento del pendiente. Habilitan la auto-detección on-chain sin pegar hash.
  expectedAmount  Decimal?      @map("expected_amount") @db.Decimal(14, 4)
  expiresAt       DateTime?     @map("expires_at")
  faseGlobalCode  String?       @map("fase_global_code")
  faseGlobalNote  String?       @map("fase_global_note")
  status          RequestStatus @default(PENDING)
  notes           String?
  // Pack Empresarial: si la solicitud es de un usuario de empresa, la revisa/aprueba
  // el admin de ESA empresa (no el super-admin). null = solicitud normal de MY DIAMOND.
  organizationId  String?       @map("organization_id") @db.Uuid
  reviewedBy      String?       @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?     @map("reviewed_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  user            User          @relation(fields: [userId], references: [id])

  @@index([organizationId, status])
  @@map("pack_purchase_requests")
}

/// Solicitud de compra de créditos AI (saldo USD). El admin la aprueba y suma al balance.
model CreditPurchaseRequest {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  /// Monto en USD que el usuario solicita cargar a su balance de IA (ej: 5, 10, 20, 50).
  amountUsd       Decimal       @db.Decimal(10, 2) @map("amount_usd")
  paymentProofUrl String?       @map("payment_proof_url")
  /// MANUAL (transferencia con comprobante) o CRYPTO (USDT-BEP20 verificado on-chain).
  paymentMethod   PaymentMethod @default(MANUAL) @map("payment_method")
  txHash          String?       @unique @map("tx_hash")
  /// Número de bloque en BSC cuando el pago CRYPTO fue verificado on-chain.
  blockNumber     BigInt?       @map("block_number")
  status          RequestStatus @default(PENDING)
  notes           String?
  reviewedBy      String?       @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?     @map("reviewed_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  user            User          @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([status])
  @@map("credit_purchase_requests")
}

/// Log de cada uso de IA con la key del admin (consumo de balance USD).
/// Si el usuario usa su propia API key, no se crea ningún registro acá.
model AIUsageLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  model     String   /// "gpt-4o", "gpt-4o-mini", "whisper-1", "dall-e-3", etc.
  reason    String   /// "ads.copies", "ads.images", "whatsapp.chat", etc.
  costUsd   Decimal  @db.Decimal(10, 4) @map("cost_usd")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("ai_usage_logs")
}

model WithdrawalRequest {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  amount        Decimal       @db.Decimal(12, 2)
  walletQrUrl   String?       @map("wallet_qr_url")

  recipientName String           @map("recipient_name")
  phone         String
  address       String
  city          String
  state         String
  country       String
  zipCode       String?          @map("zip_code")
  deliveryNotes String?          @map("delivery_notes")
  notes         String?
  createdAt     DateTime         @default(now()) @map("created_at")
